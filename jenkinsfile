pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t secure-devsecops-app .'
            }
        }

        stage('Run Container') {
            steps {
                bat 'docker stop secure-devsecops-container || exit 0'
                bat 'docker rm secure-devsecops-container || exit 0'
                bat 'docker run -d --name secure-devsecops-container -p 5000:5000 secure-devsecops-app'
            }
        }
    }
}