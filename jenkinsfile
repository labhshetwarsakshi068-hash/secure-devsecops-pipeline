pipeline{
    agent any 

    stages{
        stage ('checkout'){
            steps{
                checkout scm
            }
        }
        stage ('Build Docker Image '){
            steps{
              bat 'docker build -t secure-devesecops-app .'
            }
        }
        stage('Run container'){
            steps{
                bat 'Docker stop 
                secure-devsecops-container || exit 0'
                bat 'docker rm 
                secure-devsecops-container || exit 0'
                bat 'docker run -d --name
                secure-devesecops-container -p
                5000:5000 secure-devsecops-app'
            }
            
        }
    }
}